{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "echo no-deps",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pattern-arcade-seven.vercel.app"
        }
      ],
      "destination": "https://pattern-lab-gold.vercel.app/$1",
      "permanent": true
    }
  ]
}
